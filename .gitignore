# Ignore sensitive files
.env
.env.local
.env.*.local
secrets.json
credentials.json
*.key
*.pem

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore logs
*.log
logs/

# Ignore node_modules (if you add any JS tools)
node_modules/

